# Copy to .env for local development. All settings are optional.

# Directory for the SQLite database; relative to where the server runs.
# DATA_DIR=data

# Database file; defaults to $DATA_DIR/homeinventory.db.
# DATABASE_PATH=

# Stands in for the Tailscale identity headers when they are missing, e.g. when
# calling the dev API directly instead of through `tailscale serve`.
# Never set this in the live deployment.
# DEV_USER=you@example.com

# The household's time zone: scheduled chores fall due at its midnight.
# TIMEZONE=Europe/Budapest
